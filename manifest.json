{
  "manifest_version": 3,
  "name": "FEL CTU BRUTE Deadline Manager",
  "version": "1.29",
  "description": "Adds task management, plagiat tracking dashboard, and optional Classic UI style to FEL CTU BRUTE.",
  "icons": {
    "16": "icons/brute16.png",
    "48": "icons/brute48.png",
    "96": "icons/brute96.png",
    "128": "icons/brute128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/brute16.png",
      "48": "icons/brute48.png",
      "96": "icons/brute96.png",
      "128": "icons/brute128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["storage.js", "background.js"]
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://brute.fel.cvut.cz/*",
    "https://cw.felk.cvut.cz/*",
    "https://cw.fel.cvut.cz/*",
    "https://brute.felk.cvut.cz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://brute.fel.cvut.cz/*",
        "https://cw.felk.cvut.cz/*",
        "https://cw.fel.cvut.cz/*",
        "https://brute.felk.cvut.cz/*"
      ],
      "css": ["styles.css"],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cvut-fel-brute-deadline@profipoint.pro",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}